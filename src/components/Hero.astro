---
// Hero section component
---

<section class="pt-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 xl:px-0">
    <div class="flex flex-col items-start gap-6 pb-16 lg:w-7/12">
      <div class="inline-flex items-center justify-center rounded-full bg-white px-3 py-1 text-sm font-medium text-neutral-700 shadow-[0_2px_10px_0px_rgba(0,0,0,0.15)]">
        Pfarrjugend Zirl
      </div>
      <h1 class="bg-gradient-to-b from-slate-900 to-slate-600 bg-clip-text text-4xl font-semibold text-transparent lg:text-6xl lg:leading-tight">
        Gemeinschaft, Glaube & Aktionen für Jugendliche in Zirl
      </h1>
      <p class="max-w-2xl text-base font-medium text-slate-600 lg:text-lg">
        Wir treffen uns, gestalten Projekte und feiern gemeinsam. Hier findest du News,
        kommende Termine und alle wichtigen Infos auf einen Blick.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="#news"
          class="flex items-center justify-center rounded-[0.625rem] bg-slate-900 px-4 py-2.5 text-sm font-medium text-white shadow-[0_2px_10px_0px_rgba(0,0,0,0.2)] transition hover:bg-slate-800"
        >
          Zu den News
        </a>
        <a
          href="#termine"
          class="flex items-center justify-center rounded-[0.625rem] border border-neutral-200 bg-white px-4 py-2.5 text-sm font-medium text-neutral-700 shadow-[0_2px_10px_0px_rgba(0,0,0,0.05)] transition hover:border-neutral-300 hover:bg-neutral-100"
        >
          Kommende Termine
        </a>
      </div>
    </div>
  </div>
</section>
