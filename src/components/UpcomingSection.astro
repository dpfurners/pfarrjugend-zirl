---
const upcomingEvents = [
  {
    title: 'Pfarrball 2026',
    date: 'Weitere Infos folgen',
    location: 'Zirl',
    details: 'Alle Details findest du unter www.ball.pfarrjugend-zirl.at.',
    image: '/images/upcoming-preview.svg',
    link: 'https://www.ball.pfarrjugend-zirl.at'
  }
];

const whatsappItems = [
  {
    title: 'Hinweis: Nächste Woche keine Gruppenstunde',
    text:
      'Nächste Woche findet aufgrund der Semesterferien keine Gruppenstunde statt. Infos: https://www.pfarrjugend-zirl.at',
    image: '/images/whatsapp-info.svg'
  }
];
---

<section id="termine" class="py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 xl:px-0">
    <div class="rounded-3xl border border-emerald-100 bg-white/95 p-8 shadow-[0_12px_40px_0px_rgba(15,23,42,0.12)] lg:p-12">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="text-sm font-semibold text-emerald-600">Upcoming</p>
          <h2 class="mt-2 text-3xl font-semibold text-slate-900 lg:text-4xl">
            Kommende Termine
          </h2>
          <p class="mt-3 max-w-2xl text-base text-slate-600">
            Eine Übersicht der nächsten Treffen und Aktionen. Diese Liste ist der Einstieg
            für eine eigene „Upcoming“-Seite.
          </p>
        </div>
        <a
          class="inline-flex items-center justify-center rounded-[0.625rem] bg-emerald-600 px-4 py-2.5 text-sm font-medium text-white shadow-[0_2px_10px_0px_rgba(16,185,129,0.3)] transition hover:bg-emerald-500"
          href="mailto:pfarrjugend@pfarre-zirl.at"
        >
          Termin einreichen
        </a>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {upcomingEvents.map((event) => (
          <article class="rounded-2xl border border-emerald-100 bg-white p-6">
            <img class="h-36 w-full rounded-xl object-cover" src={event.image} alt={`Illustration für ${event.title}`} />
            <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-emerald-600">{event.date}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">{event.title}</h3>
            <p class="mt-2 text-sm font-medium text-slate-700">{event.location}</p>
            <p class="mt-3 text-sm text-slate-600">{event.details}</p>
            <a class="mt-4 inline-flex items-center text-sm font-semibold text-emerald-700" href={event.link} target="_blank" rel="noreferrer">
              Zur Pfarrball-Seite
              <span class="ml-2">→</span>
            </a>
          </article>
        ))}
      </div>

      <div class="mt-12">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <p class="text-sm font-semibold text-emerald-600">WhatsApp Info</p>
            <h3 class="mt-2 text-2xl font-semibold text-slate-900">Nachrichten schnell teilen</h3>
            <p class="mt-2 max-w-2xl text-sm text-slate-600">
              Versende Event-Updates direkt an WhatsApp – inklusive Bildvorschau und Link.
            </p>
          </div>
        </div>

        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {whatsappItems.map((item) => (
            <div class="rounded-2xl border border-emerald-100 bg-white p-6">
              <img class="h-40 w-full rounded-xl object-cover" src={item.image} alt={`WhatsApp Grafik für ${item.title}`} />
              <h4 class="mt-4 text-lg font-semibold text-slate-900">{item.title}</h4>
              <p class="mt-2 text-sm text-slate-600">
                Diese Grafik kann als Vorschau verwendet werden, wenn du den Text in WhatsApp teilst.
              </p>
              <div class="mt-4 flex flex-wrap gap-3">
                <a
                  class="inline-flex items-center rounded-[0.625rem] bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-[0_2px_10px_0px_rgba(16,185,129,0.3)] transition hover:bg-emerald-500"
                  href={`https://wa.me/?text=${encodeURIComponent(item.text)}`}
                  target="_blank"
                  rel="noreferrer"
                >
                  Über WhatsApp teilen
                </a>
                <a class="inline-flex items-center text-sm font-semibold text-emerald-700" href={item.image} target="_blank" rel="noreferrer">
                  Bild öffnen
                  <span class="ml-2">→</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
