---
// Banner/announcement bar component
---

<section class="bg-emerald-50 py-2" x-data="{ bannerVisible: true }" x-show="bannerVisible" x-transition>
  <div class="max-w-7xl mx-auto px-4 xl:px-0 flex items-center justify-between gap-x-2">
    <div class="flex w-full grow items-center gap-x-2 justify-self-center md:justify-center">
      <div class="inline-flex items-center justify-center rounded-full bg-emerald-600 px-2 py-0.5 text-sm font-medium text-white shadow-[0_2px_10px_0px_rgba(16,185,129,0.2)]">
        Nächster Termin
      </div>
      <div class="text-sm font-medium text-emerald-900">
        Jugendabend am Freitag, 22.11. um 19:00 Uhr im Pfarrsaal Zirl.
      </div>
    </div>
    <button
      class="flex h-6 w-6 cursor-pointer items-center justify-center rounded-3xl bg-emerald-100 p-1 transition hover:bg-emerald-200"
      type="button"
      aria-label="Hinweis schließen"
      @click="bannerVisible = false"
    >
      <svg
        class="h-4 text-emerald-700"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        aria-hidden="true"
        data-slot="icon"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18 18 6M6 6l12 12"
        />
      </svg>
    </button>
  </div>
</section>
