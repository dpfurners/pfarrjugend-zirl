---
// Footer component
---

<footer id="kontakt" class="bg-white py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 xl:px-0 flex flex-col gap-y-12">
    <div class="grid gap-y-8 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-4 lg:gap-x-12 lg:gap-y-0">
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-900 text-sm font-semibold text-white">
            PZ
          </div>
          <span class="text-base font-semibold text-slate-900">Pfarrjugend Zirl</span>
        </div>
        <p class="text-sm text-slate-600">
          Jugend, Gemeinschaft und Glauben im Herzen von Zirl.
        </p>
      </div>

      <div class="flex flex-col gap-y-3">
        <div class="text-sm font-bold text-neutral-700">Navigation</div>
        <a class="text-sm font-medium text-neutral-500" href="#news">News</a>
        <a class="text-sm font-medium text-neutral-500" href="#termine">Termine</a>
        <a class="text-sm font-medium text-neutral-500" href="#infos">Wichtige Infos</a>
      </div>

      <div class="flex flex-col gap-y-3">
        <div class="text-sm font-bold text-neutral-700">Kontakt</div>
        <p class="text-sm text-neutral-500">Kirchplatz 1, 6170 Zirl</p>
        <a class="text-sm font-medium text-neutral-500" href="mailto:pfarrjugend@pfarre-zirl.at">
          pfarrjugend@pfarre-zirl.at
        </a>
        <p class="text-sm text-neutral-500">+43 512 000000</p>
      </div>

      <div class="flex flex-col gap-y-3">
        <div class="text-sm font-bold text-neutral-700">Folge uns</div>
        <a class="text-sm font-medium text-neutral-500" href="https://www.instagram.com/" target="_blank" rel="noreferrer">
          Instagram
        </a>
        <a class="text-sm font-medium text-neutral-500" href="https://www.facebook.com/" target="_blank" rel="noreferrer">
          Facebook
        </a>
      </div>
    </div>

    <div class="border-b border-b-neutral-200"></div>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="text-sm font-medium text-neutral-700">
        <time>2024</time> · Pfarrjugend Zirl. Alle Rechte vorbehalten.
      </div>
      <div class="text-sm text-neutral-500">
        Bei Fragen melde dich gerne jederzeit.
      </div>
    </div>
  </div>
</footer>
