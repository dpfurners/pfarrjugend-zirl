---
// Navigation component
---

<header class="sticky top-0 z-50 py-3 backdrop-blur-md border-b border-white/20">
  <div class="max-w-7xl mx-auto px-4 xl:px-0" x-data="{ mobileMenuOpen: false }">
    <div
      class="backdrop-blur-md bg-white/95 border border-white/30 flex items-center justify-between gap-x-4 rounded-2xl py-2.5 pl-5 pr-2.5 shadow-[0_2px_10px_0px_rgba(0,0,0,0.15)] lg:grid lg:grid-cols-[1fr_auto_1fr] lg:justify-stretch lg:gap-x-12 lg:rounded-[1.375rem]"
    >
      <div class="flex items-center gap-x-4">
        <a href="#" title="Pfarrjugend Zirl" class="flex items-center gap-2">
          <div class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-600 text-sm font-semibold text-white">
            PZ
          </div>
          <span class="text-sm font-semibold text-slate-900">Pfarrjugend Zirl</span>
        </a>
        <span class="hidden h-4 w-[1px] bg-neutral-300 lg:block"></span>
      </div>
      <nav class="hidden lg:block">
        <ul class="flex items-center">
          <li>
            <a class="px-3 py-2 text-sm font-medium text-neutral-700 transition hover:text-emerald-700" href="#news">
              News
            </a>
          </li>
          <li>
            <a class="px-3 py-2 text-sm font-medium text-neutral-700 transition hover:text-emerald-700" href="#termine">
              Termine
            </a>
          </li>
          <li>
            <a class="px-3 py-2 text-sm font-medium text-neutral-700 transition hover:text-emerald-700" href="#infos">
              Wichtige Infos
            </a>
          </li>
          <li>
            <a class="px-3 py-2 text-sm font-medium text-neutral-700 transition hover:text-emerald-700" href="#kontakt">
              Kontakt
            </a>
          </li>
          <li>
            <a class="px-3 py-2 text-sm font-medium text-neutral-700 transition hover:text-emerald-700" href="/news">
              News-Seite
            </a>
          </li>
        </ul>
      </nav>
      <div class="flex items-center gap-x-10 justify-self-end">
        <span class="hidden h-4 w-[1px] bg-neutral-300 lg:block"></span>
        <div class="flex items-center gap-x-3 lg:gap-x-2">
          <a
            href="mailto:pfarrjugend@pfarre-zirl.at"
            title="Mitmachen"
            class="items-center justify-center whitespace-nowrap text-sm font-medium transition-all focus:shadow-[0_0px_0px_2px_rgba(16,185,129,0.25),0_2px_10px_0px_rgba(16,185,129,0.2)] shadow-[0_2px_10px_0px_rgba(16,185,129,0.2)] bg-emerald-600 text-white hover:bg-emerald-500 px-3 py-2 rounded-[0.625rem] flex"
          >
            Mitmachen
          </a>
          <button
            type="button"
            aria-label="Menü öffnen"
            class="lg:hidden"
            title="Menü öffnen"
            @click="mobileMenuOpen = !mobileMenuOpen"
          >
            <svg
              class="h-6 text-slate-500"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              data-slot="icon"
            >
              <path
                fill-rule="evenodd"
                d="M3 9a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 9Zm0 6.75a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 9Zm0 6.75a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 22.5Z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div
      x-show="mobileMenuOpen"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 scale-95"
      x-transition:enter-end="opacity-100 scale-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 scale-100"
      x-transition:leave-end="opacity-0 scale-95"
      class="lg:hidden mt-3 mx-4 xl:mx-0 max-w-7xl mx-auto"
    >
      <div class="backdrop-blur-md bg-white/95 border border-white/30 rounded-2xl py-4 px-4 shadow-[0_2px_10px_0px_rgba(0,0,0,0.15)]">
        <nav class="space-y-3">
          <a href="#news" class="block px-3 py-2 text-sm font-medium text-neutral-700 hover:text-emerald-700 transition-colors">News</a>
          <a href="#termine" class="block px-3 py-2 text-sm font-medium text-neutral-700 hover:text-emerald-700 transition-colors">Termine</a>
          <a href="#infos" class="block px-3 py-2 text-sm font-medium text-neutral-700 hover:text-emerald-700 transition-colors">Wichtige Infos</a>
          <a href="#kontakt" class="block px-3 py-2 text-sm font-medium text-neutral-700 hover:text-emerald-700 transition-colors">Kontakt</a>
          <a href="/news" class="block px-3 py-2 text-sm font-medium text-neutral-700 hover:text-emerald-700 transition-colors">News-Seite</a>
          <div class="pt-3 border-t border-neutral-200">
            <a href="mailto:pfarrjugend@pfarre-zirl.at" class="block w-full text-center px-3 py-2 text-sm font-medium bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 transition-colors">Mitmachen</a>
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>
