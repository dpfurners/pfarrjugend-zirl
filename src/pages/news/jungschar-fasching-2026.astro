---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Jungschar Fasching 2026 | Pfarrjugend Zirl" description="Rückblick zum Jungschar Fasching in Zirl.">
  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4 xl:px-0">
      <a class="text-sm font-semibold text-emerald-600" href="/news">← Zurück zu den News</a>
      <h1 class="mt-4 text-3xl font-semibold text-slate-900 lg:text-4xl">Jungschar Fasching</h1>
      <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-emerald-600">06. Februar 2026</p>
      <img class="mt-6 w-full rounded-2xl object-cover" src="/images/news-preview.svg" alt="Jungschar Fasching" />
      <div class="mt-6 space-y-4 text-base text-slate-700">
        <p>
          Bunte Kostüme, lustige Spiele und viele lachende Gesichter – danke an alle, die dabei waren!
        </p>
        <p>
          Wir freuen uns schon auf das nächste Fest. Fotos und Highlights sammeln wir laufend im News-Archiv.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
