---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Spieleabend im Pfarrsaal | Pfarrjugend Zirl" description="Newsbeitrag zum Spieleabend der Pfarrjugend Zirl.">
  <section class="py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4 xl:px-0">
      <a class="text-sm font-semibold text-emerald-600" href="/news">← Zurück zu den News</a>
      <h1 class="mt-4 text-3xl font-semibold text-slate-900 lg:text-4xl">Spieleabend im Pfarrsaal</h1>
      <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-emerald-600">15. November 2024</p>
      <img class="mt-6 w-full rounded-2xl object-cover" src="/images/news-preview.svg" alt="Spieleabend im Pfarrsaal" />
      <div class="mt-6 space-y-4 text-base text-slate-700">
        <p>
          Wir starten ab 18:30 Uhr mit Klassikern, neuen Spielen und Snacks. Bring gerne dein Lieblingsspiel mit!
        </p>
        <p>
          Der Abend ist offen für alle Jugendlichen ab 14 Jahren. Wir freuen uns auf neue Gesichter und einen
          gemütlichen Abend im Pfarrsaal.
        </p>
        <p>
          Fragen oder Ideen? Schreib uns gerne eine Nachricht an
          <a class="font-semibold text-emerald-700" href="mailto:pfarrjugend@pfarre-zirl.at">pfarrjugend@pfarre-zirl.at</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
